{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "dq_code": {
      "enum": [
        "data-boundary-violation",
        "execution-contract-violation",
        "provenance-failure",
        "evaluator-tampering",
        "reproducibility-failure",
        "source-freeze-mismatch"
      ]
    }
  },
  "additionalProperties": false,
  "properties": {
    "authority": {"maxLength": 1000, "minLength": 1, "type": "string"},
    "confirmations": {
      "additionalProperties": false,
      "maxProperties": 10,
      "patternProperties": {
        "^team-(0[1-9]|10)$": {
          "items": {"$ref": "#/$defs/dq_code"},
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "type": "object"
    },
    "notes": {"maxLength": 20000, "minLength": 1, "type": "string"},
    "schema_version": {"const": 1}
  },
  "required": ["schema_version", "authority", "confirmations", "notes"],
  "title": "Top40 V2 independent DQ confirmation",
  "type": "object"
}

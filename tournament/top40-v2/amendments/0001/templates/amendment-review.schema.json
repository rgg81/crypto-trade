{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.crypto-trade.invalid/top40-v2/amendment-0001-review.schema.json",
  "title": "Top-40 V2 amendment 0001 organizer review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "amendment_id",
    "decision",
    "decision_scope",
    "decision_data",
    "authorized_by",
    "reviewed_at_utc",
    "draft_sha256",
    "phase0_freeze_sha256",
    "amendment_files",
    "integration_manifest_path",
    "integration_manifest_sha256",
    "required_backfills",
    "score_calculation_implemented",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "amendment_id": {"const": "top40-v2-amendment-0001-organizer-private-score-diagnostics"},
    "decision": {"const": "approve"},
    "decision_scope": {"const": "freeze-amendment-0001-integration-and-required-backfills"},
    "decision_data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed_exact_implementation_bytes",
        "reviewed_required_backfills",
        "approved_private_numeric_disclosure_boundary",
        "approved_hold_toll_and_resume"
      ],
      "properties": {
        "reviewed_exact_implementation_bytes": {"const": true},
        "reviewed_required_backfills": {"const": true},
        "approved_private_numeric_disclosure_boundary": {"const": true},
        "approved_hold_toll_and_resume": {"const": true}
      }
    },
    "authorized_by": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^\\S(?:[\\s\\S]*\\S)?$"},
    "reviewed_at_utc": {"type": "string", "format": "date-time", "pattern": "(?:Z|\\+00:00)$"},
    "draft_sha256": {"$ref": "#/$defs/sha256"},
    "phase0_freeze_sha256": {"$ref": "#/$defs/sha256"},
    "amendment_files": {"$ref": "#/$defs/amendment_files"},
    "integration_manifest_path": {"const": "tournament/top40-v2/amendments/0001/integration-freeze.json"},
    "integration_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "required_backfills": {"$ref": "#/$defs/required_backfills"},
    "score_calculation_implemented": {"const": true},
    "notes": {"type": "string", "minLength": 1, "maxLength": 20000, "pattern": "^\\S(?:[\\s\\S]*\\S)?$"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "amendment_files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src/crypto_trade/tournament/amendment_integrity_v2.py",
        "src/crypto_trade/tournament/amendment_v2.py",
        "scripts/top40_v2_amendment_0001.py",
        "tournament/top40-v2/amendments/0001/AMENDMENT-DRAFT.md",
        "tournament/top40-v2/amendments/0001/templates/amendment-review.schema.json",
        "tournament/top40-v2/amendments/0001/templates/hold-notice.schema.json",
        "tournament/top40-v2/amendments/0001/templates/integration-manifest.schema.json",
        "tournament/top40-v2/amendments/0001/templates/diagnostic-backfill-reservation.schema.json",
        "tournament/top40-v2/amendments/0001/templates/diagnostic-backfill-result.schema.json",
        "tests/tournament/test_top40_v2_amendment_0001.py",
        "src/crypto_trade/tournament/score_diagnostics_v2.py",
        "src/crypto_trade/tournament/_score_worker_v2.py",
        "src/crypto_trade/tournament/score_adapters/team01_rdf_v1.py",
        "tournament/top40-v2/amendments/0001/SCORE-DIAGNOSTIC-SPEC.md",
        "tests/tournament/test_top40_v2_score_diagnostics.py",
        "tests/tournament/test_top40_v2_score_worker.py",
        "scripts/crypto_trade/__init__.py",
        "src/crypto_trade/tournament/amended_orchestrator_v2.py",
        "scripts/top40_v2_amended_tournament.py",
        "tests/tournament/test_top40_v2_amended_orchestrator.py"
      ],
      "properties": {
        "src/crypto_trade/tournament/amendment_integrity_v2.py": {"$ref": "#/$defs/sha256"},
        "src/crypto_trade/tournament/amendment_v2.py": {"$ref": "#/$defs/sha256"},
        "scripts/top40_v2_amendment_0001.py": {"$ref": "#/$defs/sha256"},
        "tournament/top40-v2/amendments/0001/AMENDMENT-DRAFT.md": {"$ref": "#/$defs/sha256"},
        "tournament/top40-v2/amendments/0001/templates/amendment-review.schema.json": {"$ref": "#/$defs/sha256"},
        "tournament/top40-v2/amendments/0001/templates/hold-notice.schema.json": {"$ref": "#/$defs/sha256"},
        "tournament/top40-v2/amendments/0001/templates/integration-manifest.schema.json": {"$ref": "#/$defs/sha256"},
        "tournament/top40-v2/amendments/0001/templates/diagnostic-backfill-reservation.schema.json": {"$ref": "#/$defs/sha256"},
        "tournament/top40-v2/amendments/0001/templates/diagnostic-backfill-result.schema.json": {"$ref": "#/$defs/sha256"},
        "tests/tournament/test_top40_v2_amendment_0001.py": {"$ref": "#/$defs/sha256"},
        "src/crypto_trade/tournament/score_diagnostics_v2.py": {"$ref": "#/$defs/sha256"},
        "src/crypto_trade/tournament/_score_worker_v2.py": {"$ref": "#/$defs/sha256"},
        "src/crypto_trade/tournament/score_adapters/team01_rdf_v1.py": {"$ref": "#/$defs/sha256"},
        "tournament/top40-v2/amendments/0001/SCORE-DIAGNOSTIC-SPEC.md": {"$ref": "#/$defs/sha256"},
        "tests/tournament/test_top40_v2_score_diagnostics.py": {"$ref": "#/$defs/sha256"},
        "tests/tournament/test_top40_v2_score_worker.py": {"$ref": "#/$defs/sha256"},
        "scripts/crypto_trade/__init__.py": {"$ref": "#/$defs/sha256"},
        "src/crypto_trade/tournament/amended_orchestrator_v2.py": {"$ref": "#/$defs/sha256"},
        "scripts/top40_v2_amended_tournament.py": {"$ref": "#/$defs/sha256"},
        "tests/tournament/test_top40_v2_amended_orchestrator.py": {"$ref": "#/$defs/sha256"}
      }
    },
    "required_backfills": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"$ref": "#/$defs/backfill_core"},
        {"$ref": "#/$defs/backfill_reference"}
      ],
      "items": false
    },
    "backfill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic_id", "team_id", "candidate_id",
        "candidate_registration_sha256", "trial_result_record_sha256",
        "strategy_sha256", "source_bundle_sha256", "risk_policy_sha256",
        "config_sha256", "candidate_seed", "development_target_path",
        "development_target_sha256", "runner_record_path", "runner_record_sha256"
      ],
      "properties": {
        "diagnostic_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "team_id": {"const": "team-01"},
        "candidate_id": {"enum": ["rdf-core-h21-k3-g10", "rdf-ref-001"]},
        "candidate_registration_sha256": {"$ref": "#/$defs/sha256"},
        "trial_result_record_sha256": {"$ref": "#/$defs/sha256"},
        "strategy_sha256": {"$ref": "#/$defs/sha256"},
        "source_bundle_sha256": {"$ref": "#/$defs/sha256"},
        "risk_policy_sha256": {"$ref": "#/$defs/sha256"},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_seed": {"type": "integer", "minimum": 0},
        "development_target_path": {"type": "string", "pattern": "^reports-top40-v2/team-01/development-runs/.+/targets\\.parquet$"},
        "development_target_sha256": {"$ref": "#/$defs/sha256"},
        "runner_record_path": {"type": "string", "pattern": "^reports-top40-v2/team-01/qualification-attempts/.+\\.runner-record\\.json$"},
        "runner_record_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "backfill_core": {
      "allOf": [
        {"$ref": "#/$defs/backfill"},
        {"properties": {
          "diagnostic_id": {"const": "score-ic-team-01-rdf-core-h21-k3-g10"},
          "candidate_id": {"const": "rdf-core-h21-k3-g10"},
          "development_target_path": {"const": "reports-top40-v2/team-01/development-runs/rdf-core-h21-k3-g10/targets.parquet"},
          "runner_record_path": {"const": "reports-top40-v2/team-01/qualification-attempts/rdf-core-h21-k3-g10.runner-record.json"}
        }}
      ]
    },
    "backfill_reference": {
      "allOf": [
        {"$ref": "#/$defs/backfill"},
        {"properties": {
          "diagnostic_id": {"const": "score-ic-team-01-rdf-ref-001"},
          "candidate_id": {"const": "rdf-ref-001"},
          "development_target_path": {"const": "reports-top40-v2/team-01/development-runs/rdf-ref-001/targets.parquet"},
          "runner_record_path": {"const": "reports-top40-v2/team-01/qualification-attempts/rdf-ref-001.runner-record.json"}
        }}
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crypto-trade.invalid/schemas/top40-v2/amendments/0005/development-score-diagnostic-reservation.schema.json",
  "additionalProperties": false,
  "$defs": {
    "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "commit": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "identifier": {"pattern": "^[a-z0-9][a-z0-9._-]{0,127}$", "type": "string"}
  },
  "properties": {
    "amendment_freeze_commit": {"$ref": "#/$defs/commit"},
    "amendment_freeze_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_id": {"$ref": "#/$defs/identifier"},
    "candidate_registration_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_seed": {"type": "integer"},
    "charges_team_trial_budget": {"const": false},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "development_target_path": {"type": "string"},
    "development_target_sha256": {"$ref": "#/$defs/sha256"},
    "diagnostic_id": {"type": "string"},
    "diagnostic_kind": {"const": "top40-v2-development-declared-score-diagnostic-v1"},
    "event_type": {"const": "development_score_diagnostic_reserved"},
    "executable_source_manifest_commit": {"$ref": "#/$defs/commit"},
    "executable_source_manifest_path": {"type": "string"},
    "executable_source_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "family_id": {"$ref": "#/$defs/identifier"},
    "integration_freeze_commit": {"$ref": "#/$defs/commit"},
    "integration_freeze_sha256": {"$ref": "#/$defs/sha256"},
    "non_material": {"const": true},
    "registration_commit": {"$ref": "#/$defs/commit"},
    "registration_event_record_sha256": {"$ref": "#/$defs/sha256"},
    "registration_event_sequence": {"minimum": 1, "type": "integer"},
    "registration_input_path": {"type": "string"},
    "reservation_sha256": {"$ref": "#/$defs/sha256"},
    "reserved_at_utc": {"pattern": "Z$", "type": "string"},
    "research_journal_head_sha256": {"$ref": "#/$defs/sha256"},
    "research_journal_record_count": {"minimum": 1, "type": "integer"},
    "research_state_sha256": {"$ref": "#/$defs/sha256"},
    "risk_policy_sha256": {"$ref": "#/$defs/sha256"},
    "runner_record_path": {"type": "string"},
    "runner_record_sha256": {"$ref": "#/$defs/sha256"},
    "schema_version": {"const": 1},
    "score_manifest_commit": {"$ref": "#/$defs/commit"},
    "score_manifest_path": {"type": "string"},
    "score_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_coupling_review_commit": {"$ref": "#/$defs/commit"},
    "semantic_coupling_review_path": {"type": "string"},
    "semantic_coupling_review_sha256": {"$ref": "#/$defs/sha256"},
    "snapshot_manifest_path": {"type": "string"},
    "snapshot_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "source_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "stage": {"const": "development"},
    "strategy_sha256": {"$ref": "#/$defs/sha256"},
    "team_id": {"enum": ["team-04", "team-05", "team-06", "team-07", "team-08", "team-09", "team-10"]},
    "trial_result_event_sequence": {"minimum": 1, "type": "integer"},
    "trial_result_record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "required": [
    "schema_version", "event_type", "diagnostic_kind", "diagnostic_id", "stage",
    "team_id", "family_id", "candidate_id", "candidate_registration_sha256",
    "registration_input_path", "registration_commit", "registration_event_record_sha256",
    "registration_event_sequence", "trial_result_record_sha256", "trial_result_event_sequence",
    "strategy_sha256", "risk_policy_sha256", "source_bundle_sha256", "candidate_seed",
    "config_sha256", "score_manifest_path", "score_manifest_sha256", "score_manifest_commit",
    "executable_source_manifest_path", "executable_source_manifest_sha256",
    "executable_source_manifest_commit",
    "semantic_coupling_review_path", "semantic_coupling_review_sha256",
    "semantic_coupling_review_commit", "snapshot_manifest_path", "snapshot_manifest_sha256",
    "development_target_path", "development_target_sha256", "runner_record_path",
    "runner_record_sha256", "amendment_freeze_sha256", "amendment_freeze_commit",
    "integration_freeze_sha256", "integration_freeze_commit",
    "research_state_sha256", "research_journal_record_count", "research_journal_head_sha256",
    "reserved_at_utc", "non_material", "charges_team_trial_budget", "reservation_sha256"
  ],
  "title": "Top40 V2 development declared-score reservation",
  "type": "object"
}

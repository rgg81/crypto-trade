# v2 track artifacts — regenerable
reports-v2/
models-v2/
analysis-v2/

# v1 track artifacts (refactored 2026-05-23)
# Mirror v3 behavior: track briefs + diaries on iteration branches (small text
# files); reports-v1 parquets blocked (large binaries). Strict-trunk discipline
# is enforced at MERGE-time via cherry-pick of src commits only — NOT via
# gitignore (which would break the iteration branch workflow).
reports-v1/**/*.parquet

# Parquet artifacts inside reports-v3/ (e.g., trial_oof_returns.parquet)
# can exceed GitHub's 100MB limit. Keep CSV/JSON reports tracked; never
# commit parquet files into reports-v3 again. Other parquet locations
# (data/features_v3/, etc.) already covered by the data/ rule above.
reports-v3/**/*.parquet

# Top-40 canonical team reruns are reproducible local artifacts. Keep the small common BTC
# benchmark under version control, but not per-team Parquet/CSV output directories.
reports-top40/team-*/

# Top-40 V4-R2 organizer and lane runtime artifacts. The common benchmark and frozen policy stay
# tracked; candidate/result/session evidence is content-addressed by the journal and remains local.
reports-top40-v4-r2/is/
reports-top40-v4-r2/source-archives/
reports-top40-v4-r2/historical-oos/
tournament/top40-v4-r2/broker.lock
tournament/top40-v4-r2/result.lock
tournament/top40-v4-r2/.result-command.lock
tournament/top40-v4-r2/research-journal.jsonl
tournament/top40-v4-r2/research-sessions/
tournament/top40-v4-r2/private/
tournament/top40-v4-r2/nominations/
tournament/top40-v4-r2/certificates/
tournament/top40-v4-r2/lifecycle.jsonl
tournament/top40-v4-r2/activation-freeze.json
tournament/top40-v4-r2/activation-tests.out
tournament/top40-v4-r2/selection-freeze.json
tournament/top40-v4-r2/nomination-registry.json
tournament/top40-v4-r2/teams/*/candidates/*
!tournament/top40-v4-r2/teams/*/candidates/README.md
tournament/top40-v4-r2/teams/*/feedback/*.json
tournament/top40-v4-r2/teams/*/outbox/*.json
tournament/top40-v4-r2/teams/*/work/*
!tournament/top40-v4-r2/teams/*/work/.keep

# Top-40 V5 organizer and lane runtime artifacts. Same split as V4-R2: the common benchmark,
# frozen policy and the preflight/calibration reports stay tracked because they are the evidence
# an auditor reads; candidate, result and session material is content-addressed by the journal.
# The sealed-block and scouting roots are ignored for a stronger reason than size — a sealed
# statistic that reaches version control has stopped being sealed.
reports-top40-v5/is/
reports-top40-v5/source-archives/
reports-top40-v5/historical/
paper-top40v5/engine.lock
tournament/top40-v5/broker.lock
tournament/top40-v5/result.lock
tournament/top40-v5/.result-command.lock
tournament/top40-v5/research-journal.jsonl
tournament/top40-v5/research-sessions/
tournament/top40-v5/private/
tournament/top40-v5/nominations/
tournament/top40-v5/certificates/
tournament/top40-v5/lifecycle.jsonl
tournament/top40-v5/activation-freeze.json
tournament/top40-v5/activation-tests.out
tournament/top40-v5/selection-freeze.json
tournament/top40-v5/nomination-registry.json
tournament/top40-v5/teams/*/candidates/*
!tournament/top40-v5/teams/*/candidates/README.md
tournament/top40-v5/teams/*/feedback/*.json
tournament/top40-v5/teams/*/outbox/*.json
tournament/top40-v5/teams/*/scouting/*
!tournament/top40-v5/teams/*/scouting/.keep
tournament/top40-v5/teams/*/work/*
!tournament/top40-v5/teams/*/work/.keep

# Notebook outputs and checkpoints
notebooks/output/
notebooks/.ipynb_checkpoints/

# Claude settings (track commands/skills/agents, ignore the rest)
.claude/*
!.claude/commands/
!.claude/skills/
!.claude/agents/
